# Copy this file to .dev.vars (gitignored) for local `wrangler dev`, and
# fill in real values. In production these are set via
# `wrangler secret put <NAME>` (or the Cloudflare dashboard) -- never
# committed here.

# Must match wedding-planner-api's own PROXY_SHARED_SECRET -- /api/webhook/rsvp
# and /api/webhook/album-notify proxy to that service's /invite/rsvp and
# /invite/album-notify routes now, not n8n directly.
WEDDING_API_PROXY_SECRET=your-secret-here

# Immich's shared-album access slug -- kept server-side only so it never
# reaches the browser (see worker/src/index.js's /api/album/* routes).
# Get this from Immich: open the album, click the share-link icon next to
# the collaborator avatars, and create/copy a public share link -- the slug
# is the token in *that* URL, not the album's own /albums/<uuid> address.
IMMICH_SLUG=your-immich-share-slug-here

# Also configured as a Secret on the deployed Worker.
IMMICH_BASE=https://photos.sankaranarayan.in

# Random value sent to Immich as the X-Album-Key header on every request; the
# Cloudflare WAF rule on the photos host must contain the same value. Set it
# as a Secret on the deployed Worker.
IMMICH_PROXY_KEY=your-random-key-here

# When the album may be viewed (IST, explicit +05:30 offset); see
# docs/2026-11-11-album-window-design.md. Open from OPEN up to CLOSE, closed
# until PERMANENT, then open for good. Set a window around "now" to try the
# album routes locally.
ALBUM_OPEN_AT=2026-11-28T18:00:00+05:30
ALBUM_CLOSE_AT=2026-11-28T23:00:00+05:30
ALBUM_PERMANENT_AFTER=2026-12-09T00:00:00+05:30

# Stream pages (/wedding, /reception): see docs/2026-11-12-live-stream-pages-design.md.
# A read-only YouTube Data API v3 key (restricted to that one API), used to
# check whether a stream has started. Set it as a Secret on the deployed Worker.
YOUTUBE_API_KEY=your-youtube-api-key-here
# Per page: when the page may show the player (IST, explicit +05:30 offset,
# open inclusive, close exclusive) and the YouTube video id of the scheduled
# stream (the 11 characters after /live/ in its link).
LIVE_WEDDING_OPEN_AT=2026-11-22T05:45:00+05:30
LIVE_WEDDING_CLOSE_AT=2026-11-27T23:59:59+05:30
LIVE_WEDDING_VIDEO_ID=cg4Jc0WOclU
LIVE_RECEPTION_OPEN_AT=2026-11-28T17:30:00+05:30
LIVE_RECEPTION_CLOSE_AT=2026-11-29T23:59:59+05:30
LIVE_RECEPTION_VIDEO_ID=HzD1mpUKIww
# Optional fallback: set to 1 to show the player inside the window even if
# YouTube cannot be checked. LIVE_RECEPTION_FORCE works the same way.
# LIVE_WEDDING_FORCE=1

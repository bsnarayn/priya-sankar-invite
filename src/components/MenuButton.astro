---
// Round cutlery button linking to the dinner menu. Shared by the event
// details card and the camera landing page so the two can't drift apart.
---

<div class="menu-btn-wrap">
    <a
        href="/dinner-menu"
        class="menu-btn"
        aria-label="View menu"
        data-tooltip="View menu"
    >
        <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
        >
            <path
                d="M7 3v7a2 2 0 002 2M5 3v7a2 2 0 002 2M9 3v7M7 12v9M17 21V3c-2.5 1.5-3.5 4-3.5 7H17"
            />
        </svg>
    </a>
</div>

<style>
    /* Pushes the button to the right corner in both a row (event card) and a
       column (camera page) flex container. */
    .menu-btn-wrap {
        position: relative;
        margin-left: auto;
        align-self: flex-end;
    }

    /* Same look as the RSVP toggle buttons: cream fill, teal outline, teal
       fill when pressed. */
    .menu-btn {
        position: relative;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fffbf6;
        color: #157a78;
        border: 1px solid #157a78;
        text-decoration: none;
        transition: all 0.25s ease;
    }

    .menu-btn:hover {
        background: rgba(21, 122, 120, 0.08);
    }

    .menu-btn:active,
    .menu-btn:focus-visible {
        background: #157a78;
        color: #fffbf6;
    }

    /* Tooltip, right-aligned to the button so it can't spill off the edge. */
    .menu-btn::after {
        content: attr(data-tooltip);
        position: absolute;
        right: 0;
        bottom: calc(100% + 8px);
        padding: 6px 10px;
        background: #3a2e28;
        color: #fffbf6;
        border-radius: 6px;
        font-family: "Jost", sans-serif;
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
        z-index: 5;
    }

    .menu-btn:hover::after,
    .menu-btn:focus-visible::after {
        opacity: 1;
    }
</style>

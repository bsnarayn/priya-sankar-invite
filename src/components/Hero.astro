---
interface Props {
    site: {
        groom_name: string;
        bride_name: string;
        tagline: string;
        hero_pre: string;
        tamil_names: string;
    };
    event: {
        date: string;
        time: string;
        venue: string;
    };
}
const { site, event } = Astro.props;

// Parse "28th November 2026" -> day "28", month "NOV", year "2026" for the
// calendar block.
const dateMatch = event.date.match(
    /(\d+)(?:st|nd|rd|th)?\s+([A-Za-z]+)\s+(\d{4})/,
);
const heroDay = dateMatch ? dateMatch[1] : event.date;
const heroMonth = dateMatch ? dateMatch[2].slice(0, 3).toUpperCase() : "";
const heroYear = dateMatch ? dateMatch[3] : "";

// Split "New Woodlands Hotel, Chennai" into two lines at the first comma.
const [venueLine1, ...venueRest] = event.venue.split(",");
const venueLine2 = venueRest.join(",").trim();
---

<section id="hero">
    <div class="hero-content">
        <!-- Dual-border frame — Tamil text now inside the frame,
             matching the physical invite layout. -->
        <div class="hero-frame">
            <div class="hero-frame-inner">
                <!-- Tamil names — sits at top of frame -->
                <span class="hero-tamil">{site.tamil_names}</span>

                <!-- One line gap between Tamil and English names -->
                <h1 class="hero-names">
                    {site.groom_name}
                    <span class="hero-amp">&amp;</span>
                    {site.bride_name}
                </h1>

                <!-- One line gap between names and together line -->
                <p class="hero-pre">{site.hero_pre}</p>

                <!-- Two line gaps between together line and tagline -->
                <p class="hero-tagline">{site.tagline}</p>

                <div class="hero-date-row">
                    <div class="hero-calendar">
                        <span class="hero-calendar-month">{heroMonth}</span>
                        <span class="hero-calendar-day">{heroDay}</span>
                        <span class="hero-calendar-year">{heroYear}</span>
                    </div>
                    <div class="hero-venue">
                        <svg
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            class="hero-venue-pin"
                        >
                            <path
                                d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"
                                fill="#8B1A8C"
                            />
                            <circle cx="12" cy="9" r="2.5" fill="#FFFBF6" />
                        </svg>
                        <div class="hero-venue-lines">
                            <span class="hero-venue-line">{venueLine1}</span>
                            {venueLine2 && (
                                <span class="hero-venue-line">{venueLine2}</span>
                            )}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="scroll-hint" id="scroll-hint">
        <span class="scroll-hint-label">scroll</span>
        <svg
            class="scroll-hint-icon"
            width="22"
            height="22"
            viewBox="0 0 16 16"
            fill="none"
        >
            <path
                d="M8 3v10M8 13l-4-4M8 13l4-4"
                stroke="#157A78"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
        </svg>
    </div>
</section>

<script>
    const scrollHint = document.getElementById("scroll-hint");
    let userScrolled = false;
    let nudging = false;

    if (scrollHint) {
        const onFirstScroll = () => {
            if (nudging) return;
            userScrolled = true;
            scrollHint.classList.add("scroll-hint--hidden");
            window.removeEventListener("scroll", onFirstScroll);
        };
        window.addEventListener("scroll", onFirstScroll, { passive: true });
    }

    // Repeating nudge — a small scroll-and-back a few seconds after the
    // doors open, so guests who don't notice the bouncing hint still get
    // a physical cue that the page moves. Eases both ways by hand (native
    // `behavior: "smooth"` scroll timing varies by browser and tends to
    // feel abrupt for a distance this small). Repeats a few times with a
    // gap between, and bails permanently the moment the user scrolls.
    const NUDGE_DISTANCE = 70;
    const NUDGE_DURATION = 550;
    const NUDGE_HOLD = 450;
    const NUDGE_REPEATS = 3;
    const NUDGE_GAP = 6000;

    function easeInOutQuad(t: number) {
        return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
    }

    function smoothScrollTo(target: number, duration: number) {
        return new Promise<void>((resolve) => {
            const start = window.scrollY;
            const delta = target - start;
            const startTime = performance.now();

            function step(now: number) {
                if (userScrolled) return resolve();
                const elapsed = now - startTime;
                const t = Math.min(elapsed / duration, 1);
                window.scrollTo(0, start + delta * easeInOutQuad(t));
                if (t < 1) requestAnimationFrame(step);
                else resolve();
            }
            requestAnimationFrame(step);
        });
    }

    async function nudgeOnce() {
        if (userScrolled || window.scrollY > 4) return;
        nudging = true;
        await smoothScrollTo(NUDGE_DISTANCE, NUDGE_DURATION);
        await new Promise((r) => setTimeout(r, NUDGE_HOLD));
        if (!userScrolled) await smoothScrollTo(0, NUDGE_DURATION);
        // The browser can dispatch "scroll" events a frame or two behind
        // our own programmatic scrollTo calls. Keep the guard up briefly
        // after we're done so one of those late events doesn't get
        // misread as the user scrolling.
        await new Promise((r) => setTimeout(r, 300));
        nudging = false;
    }

    async function nudgeScroll() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            return;
        }
        for (let i = 0; i < NUDGE_REPEATS; i++) {
            if (userScrolled) break;
            await nudgeOnce();
            if (userScrolled) break;
            await new Promise((r) => setTimeout(r, NUDGE_GAP));
        }
    }

    window.addEventListener("invite:opened", () => {
        setTimeout(nudgeScroll, 3500);
    });
</script>

---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";

const categories = (await getCollection("menu")).sort(
    (a, b) => a.data.order - b.data.order,
);

const credited = categories.flatMap((cat) =>
    cat.data.items.filter((item) => item.photo && item.credit),
);
---

<Base title="Dinner Menu — Sankar & Priya">
    <Header showImmediately={true} />

    <section id="menu">
        <div class="menu-inner">
            <div class="sec-heading-row">
                <h2 class="sec-heading">Dinner</h2>
                <span class="sec-script">menu</span>
            </div>
            <p class="sec-sub menu-intro">
                Come hungry — a grand feast of festive favourites awaits, served
                in the traditional order, beginning with a sweet and ending with
                a sweet beeda.
            </p>

            {
                categories.length === 0 ? (
                    <p class="menu-empty">Menu coming soon.</p>
                ) : (
                    categories.map((cat) => (
                        <div class="menu-category">
                            <h3 class="menu-cat-title">{cat.data.title}</h3>
                            <div
                                class:list={["menu-grid", cat.data.columns && "menu-grid-fixed"]}
                            >
                                {cat.data.items.map((item) => (
                                    <article class="menu-card">
                                        <div class="menu-photo">
                                            {item.photo ? (
                                                <img
                                                    src={`/images/menu/${item.photo}`}
                                                    alt={item.name}
                                                    loading="lazy"
                                                    decoding="async"
                                                />
                                            ) : (
                                                <div class="menu-photo-placeholder">
                                                    <svg
                                                        width="28"
                                                        height="28"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="#C4622D"
                                                        stroke-width="1"
                                                        stroke-linecap="round"
                                                    >
                                                        <circle
                                                            cx="12"
                                                            cy="12"
                                                            r="9"
                                                        />
                                                        <circle
                                                            cx="12"
                                                            cy="12"
                                                            r="5"
                                                        />
                                                    </svg>
                                                    <span>Photo coming soon</span>
                                                </div>
                                            )}
                                        </div>
                                        <div class="menu-body">
                                            <h4 class="menu-name">
                                                {item.name}
                                            </h4>
                                            {item.description && (
                                                <p class="menu-desc">
                                                    {item.description}
                                                </p>
                                            )}
                                            {item.sides && (
                                                <div class="menu-sides">
                                                    <span class="menu-sides-label">
                                                        {item.sides_label ??
                                                            "Choice of"}
                                                    </span>
                                                    <ul>
                                                        {item.sides.map(
                                                            (side) => (
                                                                <li>{side}</li>
                                                            ),
                                                        )}
                                                    </ul>
                                                </div>
                                            )}
                                        </div>
                                    </article>
                                ))}
                            </div>
                        </div>
                    ))
                )
            }

            <p class="menu-note">Photos are for illustration only.</p>

            {/* Kept in the markup but hidden on purpose: remove the `hidden`
                attribute to show photo credits on the page. */}
            {
                credited.length > 0 && (
                    <details class="menu-credits" hidden>
                        <summary>Photo credits</summary>
                        <p class="menu-credits-note">
                            Images from Wikimedia Commons, Flickr and Pexels,
                            resized and cropped.
                        </p>
                        <ul>
                            {credited.map((item) => (
                                <li>
                                    {item.name} —{" "}
                                    <a
                                        href={item.credit!.source}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        {item.credit!.author}
                                    </a>
                                    , {item.credit!.license}
                                </li>
                            ))}
                        </ul>
                    </details>
                )
            }

            <a class="menu-back" href="/">Back</a>
        </div>
    </section>
</Base>

<script>
    // Go back to wherever the guest came from (invite or camera page). The
    // link's own href ("/") is the fallback when the menu was opened directly,
    // e.g. from the reminder email.
    document.querySelector(".menu-back")?.addEventListener("click", (e) => {
        if (document.referrer.startsWith(location.origin) && history.length > 1) {
            e.preventDefault();
            history.back();
        }
    });
</script>

<style>
    #menu {
        min-height: 100svh;
        background-color: var(--color-base);
        display: flex;
        justify-content: center;
        /* Same top offset as the album page: clears the fixed header. */
        padding: 140px 24px 64px;
    }

    .menu-inner {
        max-width: 720px;
        width: 100%;
        text-align: left;
    }

    /* The shared heading row centres itself; this page is left-aligned. */
    .menu-inner .sec-heading-row {
        justify-content: flex-start;
    }

    .menu-intro {
        max-width: 560px;
        margin-bottom: 0;
    }

    .menu-empty {
        font-family: var(--font-family-serif);
        font-style: italic;
        font-size: 16px;
        color: var(--color-text-muted);
        margin-top: 24px;
    }

    .menu-category {
        margin-top: 44px;
    }

    .menu-cat-title {
        font-family: var(--font-family-display);
        font-weight: 400;
        font-size: 30px;
        color: var(--color-text-primary);
        margin-bottom: 22px;
        text-align: center;
    }

    .menu-cat-title::after {
        content: "";
        display: block;
        width: 48px;
        height: 1px;
        background: var(--color-accent-gold);
        margin: 10px auto 0;
    }

    /* Centred, so a lone or odd last card sits in the middle and the page
       reads symmetrically (1, 3, 4, 3 cards on a wide screen). */
    .menu-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 14px;
    }

    .menu-card {
        flex: 0 0 calc(50% - 7px);
        min-width: 0;
        text-align: left;
        background: var(--color-surface);
        border: 0.5px solid var(--color-border-soft);
        border-radius: 12px;
        overflow: hidden;
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.85),
            0 4px 8px -2px rgba(58, 46, 40, 0.1),
            0 12px 28px -8px rgba(58, 46, 40, 0.18);
    }

    @media (min-width: 640px) {
        .menu-grid {
            gap: 18px;
        }
        .menu-card {
            flex-basis: calc((100% - 36px) / 3);
        }
    }

    /* A single-row category (columns set in menu.json). Cards never shrink: on
       screens wide enough, the row is widened past the page margins so all
       four fit at the same size as in the other categories; on narrower
       screens the cards simply wrap two to a row. No sideways scrolling. */
    @media (max-width: 1039px) {
        .menu-grid-fixed .menu-card {
            flex-basis: calc(50% - 7px);
        }
    }
    @media (min-width: 1040px) {
        /* 4 cards of 228px (the 3-per-row card width of the 720px column)
           plus 3 gaps of 18px = 966px, centred on the 720px column. */
        .menu-grid-fixed {
            flex-wrap: nowrap;
            width: 966px;
            margin-left: calc(50% - 483px);
        }
        .menu-grid-fixed .menu-card {
            flex: 0 0 228px;
        }
    }

    .menu-photo {
        aspect-ratio: 1;
        background: var(--color-card);
    }

    .menu-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .menu-photo-placeholder {
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .menu-photo-placeholder span {
        color: #8c7060;
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        opacity: 0.5;
    }

    .menu-body {
        padding: 12px 14px 16px;
    }

    .menu-name {
        font-family: var(--font-family-display);
        font-weight: 400;
        font-size: 19px;
        line-height: 1.2;
        color: var(--color-text-primary);
    }

    .menu-desc {
        font-family: var(--font-family-serif);
        font-style: italic;
        font-size: 14px;
        line-height: 1.5;
        color: var(--color-text-muted);
        margin-top: 6px;
    }

    .menu-sides {
        margin-top: 10px;
    }

    .menu-sides-label {
        display: block;
        font-family: var(--font-family-sans);
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-text-muted);
        margin-bottom: 6px;
    }

    .menu-sides ul {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .menu-sides li {
        font-family: var(--font-family-sans);
        font-size: 12px;
        color: var(--color-text-body);
        border: 0.5px solid var(--color-accent-gold);
        border-radius: 999px;
        padding: 3px 10px;
        background: var(--color-base);
    }

    .menu-note {
        margin-top: 56px;
        font-family: var(--font-family-sans);
        font-size: 12px;
        color: var(--color-text-muted);
    }

    .menu-credits {
        margin-top: 16px;
        font-family: var(--font-family-sans);
        font-size: 12px;
        color: var(--color-text-muted);
    }

    .menu-credits summary {
        cursor: pointer;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-size: 10px;
    }

    .menu-credits-note {
        margin: 14px 0 10px;
        line-height: 1.6;
    }

    .menu-credits ul {
        list-style: none;
        display: grid;
        gap: 4px;
        line-height: 1.5;
    }

    .menu-credits a {
        color: var(--color-accent);
    }

    .menu-back {
        display: inline-block;
        margin-top: 40px;
        font-family: var(--font-family-sans);
        font-size: 13px;
        letter-spacing: 0.04em;
        color: var(--color-accent);
        text-decoration: none;
    }

    .menu-back:hover {
        color: var(--color-accent-dark);
    }
</style>
